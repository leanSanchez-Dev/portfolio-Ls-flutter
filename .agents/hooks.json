{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "python3 .cursor/hooks/session-start.py"
      }
    ],
    "beforeShellExecution": [
      {
        "command": "python3 .cursor/hooks/before-shell.py",
        "matcher": "firebase\\s+deploy|git\\s+push|git\\s+reset\\s+--hard|flutter\\s+build\\s+web|rm\\s+-rf\\s+/",
        "failClosed": true
      }
    ],
    "afterFileEdit": [
      {
        "command": "python3 .cursor/hooks/after-file-edit.py"
      }
    ],
    "subagentStop": [
      {
        "command": "python3 .cursor/hooks/subagent-stop.py",
        "loop_limit": 1
      }
    ],
    "stop": [
      {
        "command": "python3 .cursor/hooks/stop-quality-gate.py",
        "loop_limit": 1
      }
    ]
  }
}
